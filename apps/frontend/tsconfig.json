{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"],
      "@pages/*": ["src/pages/*"],
      "@features/*": ["src/features/*"],
      "@entities/*": ["src/entities/*"],
      "@shared/*": ["src/shared/*"],
      "@components/*": ["src/components/*"],
      "@zistributo/contracts": ["../../packages/contracts/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["src", "rspack.config.mjs", "tailwind.config.ts"]
}
